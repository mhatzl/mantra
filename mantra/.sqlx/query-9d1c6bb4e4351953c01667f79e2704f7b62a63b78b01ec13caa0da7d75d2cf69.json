  "query": "\n                        select * from TestCases tc\n                        where\n                            collect_nr = (\n                                select max(ctc.collect_nr)\n                                from TestCases ctc\n                                where ctc.product_id = tc.product_id\n                            )\n                            and product_id = $1\n                            and test_run_name = $2\n                            and test_run_date = $3\n                            and name = $4\n                        ",
