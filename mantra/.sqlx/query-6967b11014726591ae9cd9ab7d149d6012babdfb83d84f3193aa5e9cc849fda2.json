  "query": "\n            select rp.product_id, rp.req_id, rp.parent_product_id, rp.parent_req_id\n            from RequirementParents rp\n            where not exists (\n                select r.id\n                from Requirements r\n                where rp.parent_product_id = r.product_id\n                and rp.parent_req_id = r.id\n            )\n            ",
