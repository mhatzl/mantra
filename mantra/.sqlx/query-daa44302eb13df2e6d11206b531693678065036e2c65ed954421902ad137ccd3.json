  "query": "\n                                select * from TestCaseLineCoverage tc\n                                where\n                                    collect_nr = (\n                                        select max(ctc.collect_nr)\n                                        from TestCaseLineCoverage ctc\n                                        where ctc.product_id = tc.product_id\n                                    )\n                                    and product_id = $1\n                                    and test_run_name = $2\n                                    and test_run_date = $3 and test_case_name = $4\n                                    and cov_filepath = $5 and cov_line = $6\n                                ",
