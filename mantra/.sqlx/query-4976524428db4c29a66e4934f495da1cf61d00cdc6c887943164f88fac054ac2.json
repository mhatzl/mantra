  "query": "\n            select rc.product_id, rc.req_id, rc.child_product_id, rc.child_req_id\n            from RequirementChildren rc\n            where not exists (\n                select r.id\n                from Requirements r\n                where rc.child_product_id = r.product_id\n                and rc.child_req_id = r.id\n            )\n            ",
