  "query": "\n        select\n            rs.product_id,\n            rs.req_id,\n            rs.state,\n            exists (\n                select req_id\n                from OptionalRequirements o\n                where o.product_id = $1 and o.req_id = rs.req_id\n            ) as \"optional!:bool\",\n            exists (\n                select req_id\n                from ManualRequirements o\n                where o.product_id = $1 and o.req_id = rs.req_id\n            ) as \"manual!:bool\"\n        from RequirementVerificationStates rs\n        where rs.product_id = $1\n        ",
