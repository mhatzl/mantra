  "query": "\n                    select\n                        c.collected_at_utc as \"last_collected_date\",\n                        p.id,\n                        p.name,\n                        p.base,\n                        p.version,\n                        p.homepage,\n                        p.repository,\n                        p.license,\n                        gt.content as \"description?\"\n                    from Products p left join GeneralTexts gt on p.description_hash = gt.hash,\n                        Collections c\n                    where p.latest_collection = c.id\n                ",
