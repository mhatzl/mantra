  "query": "\n        select\n            tr.utc_date,\n            tr.duration_sec,\n            gt.content as \"description?\",\n            og.content as \"origin?\"\n        from TestRuns tr\n        left join GeneralTexts gt on tr.description_hash = gt.hash\n        left join GeneralJson og on tr.origin_hash = og.hash\n        where tr.product_id = $1 and tr.name = $2\n        ",
