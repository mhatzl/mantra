{
    name: "mantra",
    license: "MIT",
    repository: "https://github.com/mhatzl/mantra",
    products: [
        {
            name: "$inherit",
            license: "$inherit",
            repository: "$inherit",
            base: "main",
            requirements: [
                {
                    path: "test-content/reqs/",
                    source: "schema",
                },
                {
                    path: "test-content/markup-reqs/",
                    source: "markup",
                }
            ],
            annotations: [
                {
                    path: "test-content/annotations/",
                    source: "schema",
                },
                {
                    path: "./",
                    source: "content",
                    pattern: "*.rs"
                }
            ],
            test_runs: [
                {
                    path: "target/nextest/default",
                    source: {
                        test: {
                            format: "junit",
                            pattern: "*junit.xml",
                        },
                        coverage: {
                            format: "cobertura_loose",
                            pattern: "*cobertura.xml",
                        }
                    }
                },
                {
                    path: "test-content/test-runs/",
                    source: "schema",
                }
            ],
            reviews: [
                {
                    path: "test-content/reviews/",
                    source: "schema",
                }
            ]
        }
    ],
    reports: {
        template_dir: "test-content/custom-templates"
    }
}